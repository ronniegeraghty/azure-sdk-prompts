# Required by app.py. Replace the account name; this is not a secret.
AZURE_STORAGE_ACCOUNT_URL=https://<storage-account-name>.blob.core.windows.net

# Recommended in Azure deployments to disable developer-tool credentials.
# AZURE_TOKEN_CREDENTIALS=prod

# Set this for a user-assigned managed identity.
# AZURE_CLIENT_ID=<managed-identity-client-id>

# Optional troubleshooting switch used by app.py.
# AZURE_SDK_LOG_LEVEL=DEBUG

