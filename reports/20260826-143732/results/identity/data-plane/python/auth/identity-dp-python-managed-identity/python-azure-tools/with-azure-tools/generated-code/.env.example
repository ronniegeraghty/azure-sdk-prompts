# The CLI also accepts these values as command-line arguments.
AZURE_BLOB_ACCOUNT_URL=https://your-account.blob.core.windows.net
IDENTITY_MODE=auto

# Set only when selecting a user-assigned identity.
MANAGED_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional: constrain DefaultAzureCredential in production.
# AZURE_TOKEN_CREDENTIALS=prod

# Optional diagnostic logging. Logs can contain sensitive metadata.
# AZURE_LOG_LEVEL=debug
