# system, user, or local
AZURE_IDENTITY_MODE=local

# Required only when AZURE_IDENTITY_MODE=user.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Resource endpoints used to construct SDK clients. No request is made by the demo.
AZURE_STORAGE_ACCOUNT_URL=https://example.blob.core.windows.net
AZURE_KEY_VAULT_URL=https://example.vault.azure.net

