AZURE_STORAGE_ACCOUNT_URL=https://your-account.blob.core.windows.net
AZURE_STORAGE_CONTAINER=blob-manager-demo
AZURE_TOKEN_CREDENTIALS=prod
AZURE_STORAGE_MAX_RETRIES=5
AZURE_STORAGE_RETRY_DELAY=1.0
AZURE_STORAGE_RETRY_MAX_DELAY=30.0
AZURE_HTTP_LOGGING_ENABLED=false
AZURE_HTTP_LOG_LEVEL=WARNING
AZURE_STORAGE_MAX_BLOCK_SIZE=4194304
AZURE_STORAGE_MAX_SINGLE_PUT_SIZE=8388608
AZURE_STORAGE_MAX_CONCURRENCY=4
