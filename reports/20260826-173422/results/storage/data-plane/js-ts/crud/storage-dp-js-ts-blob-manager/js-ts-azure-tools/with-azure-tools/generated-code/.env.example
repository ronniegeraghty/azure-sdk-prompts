AZURE_STORAGE_BLOB_ENDPOINT=https://your-account.blob.core.windows.net
AZURE_STORAGE_CONTAINER=blob-manager-demo
# Set this only for a user-assigned managed identity.
AZURE_CLIENT_ID=
AZURE_STORAGE_MAX_RETRIES=5
AZURE_STORAGE_RETRY_DELAY_MS=800
AZURE_STORAGE_MAX_RETRY_DELAY_MS=10000
AZURE_LOG_LEVEL=warning
