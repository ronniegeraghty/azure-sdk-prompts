# Use either the full account URL or derive it from the account name.
AZURE_STORAGE_ACCOUNT_URL=https://your-account.blob.core.windows.net
# AZURE_STORAGE_ACCOUNT_NAME=your-account

# Required for a user-assigned managed identity. This is the identity's client ID,
# not its object/principal ID.
AZURE_MANAGED_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional for DefaultAzureCredential in production. This limits the chain to
# deployment-safe credentials in azure-identity versions that support it.
# AZURE_TOKEN_CREDENTIALS=prod
