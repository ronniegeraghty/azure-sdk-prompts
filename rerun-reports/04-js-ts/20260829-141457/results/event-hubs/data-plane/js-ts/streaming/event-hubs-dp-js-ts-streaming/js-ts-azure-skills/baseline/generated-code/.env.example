EVENT_HUB_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<key-name>;SharedAccessKey=<key>
EVENT_HUB_NAME=<event-hub-name>
BLOB_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account-name>;AccountKey=<account-key>;EndpointSuffix=core.windows.net
BLOB_CONTAINER_NAME=<existing-checkpoint-container>
EVENT_HUB_CONSUMER_GROUP=$Default
