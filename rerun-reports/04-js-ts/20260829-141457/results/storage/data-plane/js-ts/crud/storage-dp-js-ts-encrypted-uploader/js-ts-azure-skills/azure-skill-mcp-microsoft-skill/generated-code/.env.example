AZURE_STORAGE_BLOB_ENDPOINT=https://<storage-account>.blob.core.windows.net
AZURE_KEY_VAULT_ENDPOINT=https://<vault-name>.vault.azure.net
AZURE_KEY_VAULT_KEY_NAME=<rsa-key-name>
AZURE_STORAGE_CONTAINER=<container-name>
AZURE_STORAGE_BLOB_NAME=encrypted-demo.txt

# Optional: the client ID of a user-assigned managed identity.
AZURE_CLIENT_ID=
