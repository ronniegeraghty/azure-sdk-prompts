AZURE_STORAGE_ACCOUNT_ENDPOINT=https://your-account.blob.core.windows.net
AZURE_STORAGE_CONTAINER_NAME=blob-manager-demo
AZURE_STORAGE_MAX_RETRIES=5
AZURE_STORAGE_RETRY_DELAY_MS=1000
AZURE_STORAGE_MAX_RETRY_DELAY_MS=30000
AZURE_STORAGE_LEASE_WAIT_MS=30000
AZURE_STORAGE_LEASE_POLL_MS=1000
AZURE_STORAGE_UPLOAD_BUFFER_SIZE=8388608
AZURE_STORAGE_UPLOAD_CONCURRENCY=5
AZURE_SDK_LOG_LEVEL=warning
# Set this only when using a user-assigned managed identity.
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
