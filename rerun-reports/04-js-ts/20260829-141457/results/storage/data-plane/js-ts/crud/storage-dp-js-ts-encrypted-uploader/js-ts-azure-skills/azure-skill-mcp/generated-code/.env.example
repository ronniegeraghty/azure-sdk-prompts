AZURE_STORAGE_BLOB_ENDPOINT=https://<storage-account>.blob.core.windows.net
AZURE_STORAGE_CONTAINER=<existing-container>
AZURE_KEY_VAULT_URL=https://<vault-name>.vault.azure.net
AZURE_KEY_NAME=<rsa-key-name>
# Optional for a user-assigned managed identity:
# AZURE_CLIENT_ID=<managed-identity-client-id>
# Optional demo blob name:
# AZURE_BLOB_NAME=envelope-encryption-demo.txt
