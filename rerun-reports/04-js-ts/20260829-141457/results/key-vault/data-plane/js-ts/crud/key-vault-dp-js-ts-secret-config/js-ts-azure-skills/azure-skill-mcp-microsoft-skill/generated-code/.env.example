KEY_VAULT_URL=https://your-vault-name.vault.azure.net
# Set this only for a user-assigned managed identity.
AZURE_CLIENT_ID=

# The demo uses an offline in-memory client unless this is set to azure.
DEMO_MODE=mock

# Destructive cleanup in Azure requires both values.
RUN_DESTRUCTIVE_CLEANUP=false
PURGE_CONFIRM_SECRET_NAME=
