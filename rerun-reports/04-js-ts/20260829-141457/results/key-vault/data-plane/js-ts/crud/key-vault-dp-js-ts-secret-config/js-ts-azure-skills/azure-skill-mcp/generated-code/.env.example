KEY_VAULT_URL=https://your-vault-name.vault.azure.net
AZURE_CLIENT_ID=
CONFIG_SECRET_NAMES=DatabaseConnectionString,ExternalApiKey,FeatureFlag
EXPIRY_WARNING_DAYS=7
AUTO_REFRESH_INTERVAL_MINUTES=60

# Optional version retrieval demo
VERSIONED_SECRET_NAME=
SECRET_VERSION=

# Rotation is disabled unless explicitly enabled.
ENABLE_ROTATION_DEMO=false
ROTATE_SECRET_NAME=
ROTATE_SECRET_VALUE=
ROTATE_SECRET_EXPIRY_DAYS=90

# Purge is irreversible and deletes every version under the secret name.
ENABLE_PURGE_DEMO=false
PURGE_SECRET_NAME=
