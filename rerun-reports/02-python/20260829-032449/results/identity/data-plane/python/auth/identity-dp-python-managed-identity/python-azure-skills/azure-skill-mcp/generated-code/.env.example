# Never commit real identifiers or credentials.
AZURE_STORAGE_ACCOUNT_URL=https://<account-name>.blob.core.windows.net

# Required only for --auth user.
AZURE_MANAGED_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional local DefaultAzureCredential hardening supported by recent azure-identity versions.
# AZURE_TOKEN_CREDENTIALS=dev

