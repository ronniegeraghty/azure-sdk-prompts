# Use "mock" for the local, offline demo or "azure" for Azure Key Vault.
KEY_VAULT_DEMO_MODE=mock

# Required when KEY_VAULT_DEMO_MODE=azure.
KEY_VAULT_URL=https://your-vault-name.vault.azure.net/

# Optional: client ID of a user-assigned managed identity.
AZURE_CLIENT_ID=

# Destructive Azure cleanup is skipped unless this is explicitly enabled.
RUN_DESTRUCTIVE_CLEANUP=false

# Expiry warning window used by the cache.
SECRET_EXPIRY_WARNING_DAYS=7
