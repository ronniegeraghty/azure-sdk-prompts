{
  "name": "azure-blob-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable Azure Blob Storage management utility using managed identity",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@azure/identity": "^4.11.1",
    "@azure/logger": "^1.3.0",
    "@azure/storage-blob": "^12.28.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
