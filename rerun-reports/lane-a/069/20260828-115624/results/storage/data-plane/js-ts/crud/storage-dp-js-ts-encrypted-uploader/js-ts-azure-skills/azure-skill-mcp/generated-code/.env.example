AZURE_STORAGE_BLOB_ENDPOINT=https://<storage-account>.blob.core.windows.net
AZURE_STORAGE_CONTAINER=<container-name>
AZURE_KEY_VAULT_ENDPOINT=https://<key-vault-name>.vault.azure.net
AZURE_KEY_VAULT_KEY_NAME=<rsa-key-name>
# Optional: pin an existing key version. If omitted, the current version is resolved and pinned at startup.
AZURE_KEY_VAULT_KEY_VERSION=
# Optional: client ID of a user-assigned managed identity.
AZURE_CLIENT_ID=
